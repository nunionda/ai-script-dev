# Hosting environment variables; never commit real credentials.
NODE_ENV=production
PORT=8787
# Mount a persistent volume here when running the Docker image.
FRAME_DB=/app/data/frame.db
ANTHROPIC_API_KEY=
FRAME_MODEL=claude-opus-5-5
FRAME_PUBLIC_URL=https://script.marionette-studios.com
FRAME_ADMIN_EMAIL=nunionda@gmail.com
# Required only when the administrator account is first created. 14+ characters.
FRAME_ADMIN_PASSWORD=
# Set to 1 only behind one trusted reverse proxy.
FRAME_TRUST_PROXY=0
